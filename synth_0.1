#include <SPI.h>
#include <math.h>

// ======================================================
// PIN CONFIG
// ======================================================

#define PIN_CS     5
#define PIN_SCK    18
#define PIN_MOSI   23

#define PIN_PITCH  4
#define PIN_VOLUME 15
#define PIN_BUTTON 22

// ======================================================
// AUDIO CONFIG
// ======================================================

const uint32_t SAMPLE_RATE = 22050;
const uint32_t SAMPLE_PERIOD_US = 1000000UL / SAMPLE_RATE;

const int DAC_CENTER = 2048;
const int DAC_AMP_MAX = 1700;

const int SINE_TABLE_SIZE = 256;
int16_t sineTable[SINE_TABLE_SIZE];

// ======================================================
// SYNTH STATE
// ======================================================

enum Waveform {
  WAVE_SINE = 0,
  WAVE_SQUARE,
  WAVE_SAW,
  WAVE_TRIANGLE,
  WAVE_PULSE,
  WAVE_NOISE,
  WAVE_DOUBLE_SAW,
  WAVE_SUB_SQUARE,
  WAVE_SINE_SUB,
  WAVE_COUNT
};

Waveform waveform = WAVE_SINE;

float phase = 0.0f;
float phase2 = 0.0f;
float subPhase = 0.0f;

float frequency = 220.0f;
float targetFrequency = 220.0f;

float volume = 0.4f;
float targetVolume = 0.4f;

float pulseWidth = 0.25f;
float morphGain = 1.0f;

uint32_t noiseSeed = 22222;

// Filtro progressivo controlli
float pitchFiltered = 0.0f;
float volumeFiltered = 0.0f;

// ======================================================
// TIMING
// ======================================================

uint32_t lastSampleMicros = 0;
uint32_t lastControlsMillis = 0;
uint32_t lastSerialMillis = 0;

// ======================================================
// DEBUG MODE
// ======================================================

bool debugSerialEnabled = false;

// ======================================================
// BUTTON STATE
// ======================================================

bool buttonWasPressed = false;
uint32_t buttonPressStart = 0;
const uint32_t LONG_PRESS_MS = 800;

// ======================================================
// MCP4922 WRITE
// ======================================================

inline void writeMCP4922A(uint16_t value) {
  value &= 0x0FFF;

  uint16_t command = 0x3000 | value;

  digitalWrite(PIN_CS, LOW);
  SPI.transfer16(command);
  digitalWrite(PIN_CS, HIGH);
}

// ======================================================
// WAVES
// ======================================================

float fastSine(float ph) {
  float pos = ph * SINE_TABLE_SIZE;

  int index0 = (int)pos & 255;
  int index1 = (index0 + 1) & 255;

  float frac = pos - (float)((int)pos);

  float s0 = (float)sineTable[index0] / 2047.0f;
  float s1 = (float)sineTable[index1] / 2047.0f;

  return s0 + (s1 - s0) * frac;
}

float squareWave(float ph) {
  return ph < 0.5f ? 1.0f : -1.0f;
}

float sawWave(float ph) {
  return (ph * 2.0f) - 1.0f;
}

float triangleWave(float ph) {
  return 1.0f - 4.0f * fabsf(ph - 0.5f);
}

float pulseWave(float ph, float width) {
  return ph < width ? 1.0f : -1.0f;
}

float noiseWave() {
  noiseSeed = noiseSeed * 1664525UL + 1013904223UL;
  uint16_t n = (noiseSeed >> 16) & 0xFFFF;
  return ((float)n / 32768.0f) - 1.0f;
}

void advancePhase(float &ph, float freq) {
  ph += freq / (float)SAMPLE_RATE;

  while (ph >= 1.0f) {
    ph -= 1.0f;
  }
}

// ======================================================
// OSCILLATOR
// ======================================================

float oscillatorProcess() {
  float out = 0.0f;

  switch (waveform) {
    case WAVE_SINE:
      out = fastSine(phase);
      break;

    case WAVE_SQUARE:
      out = squareWave(phase);
      break;

    case WAVE_SAW:
      out = sawWave(phase);
      break;

    case WAVE_TRIANGLE:
      out = triangleWave(phase);
      break;

    case WAVE_PULSE:
      out = pulseWave(phase, pulseWidth);
      break;

    case WAVE_NOISE:
      out = noiseWave();
      break;

    case WAVE_DOUBLE_SAW:
      out = (sawWave(phase) * 0.55f) + (sawWave(phase2) * 0.45f);
      break;

    case WAVE_SUB_SQUARE:
      out = (sawWave(phase) * 0.65f) + (squareWave(subPhase) * 0.35f);
      break;

    case WAVE_SINE_SUB:
      out = (fastSine(phase) * 0.75f) + (squareWave(subPhase) * 0.25f);
      break;

    default:
      out = 0.0f;
      break;
  }

  advancePhase(phase, frequency);
  advancePhase(phase2, frequency * 1.01f);
  advancePhase(subPhase, frequency * 0.5f);

  if (morphGain < 1.0f) {
    morphGain += 0.0025f;
    if (morphGain > 1.0f) {
      morphGain = 1.0f;
    }
  }

  out *= morphGain;

  if (out > 1.0f) out = 1.0f;
  if (out < -1.0f) out = -1.0f;

  return out;
}

// ======================================================
// CONTROLS
// ======================================================

void handleButton() {
  bool reading = digitalRead(PIN_BUTTON);

  if (reading == LOW && !buttonWasPressed) {
    buttonWasPressed = true;
    buttonPressStart = millis();
  }

  if (reading == HIGH && buttonWasPressed) {
    uint32_t pressDuration = millis() - buttonPressStart;
    buttonWasPressed = false;

    if (pressDuration >= LONG_PRESS_MS) {
      debugSerialEnabled = !debugSerialEnabled;

      Serial.print("DEBUG SERIAL: ");
      Serial.println(debugSerialEnabled ? "ON" : "OFF");
    } else {
      waveform = (Waveform)((waveform + 1) % WAVE_COUNT);
      morphGain = 0.0f;
    }
  }
}

void updateControls() {
  int pitchRaw = analogRead(PIN_PITCH);
  int volumeRaw = analogRead(PIN_VOLUME);

  pitchFiltered += ((float)pitchRaw - pitchFiltered) * 0.08f;
  volumeFiltered += ((float)volumeRaw - volumeFiltered) * 0.08f;

  float normalizedPitch = pitchFiltered / 4095.0f;

  // Pitch ridotto: circa 55 Hz - 880 Hz
  targetFrequency = 55.0f * powf(2.0f, normalizedPitch * 4.0f);

  targetVolume = volumeFiltered / 4095.0f;
  targetVolume *= 0.85f;

  pulseWidth = 0.10f + normalizedPitch * 0.80f;

  if (pulseWidth < 0.05f) pulseWidth = 0.05f;
  if (pulseWidth > 0.95f) pulseWidth = 0.95f;

  handleButton();
}

// ======================================================
// SERIAL DEBUG
// ======================================================

const char* waveformName() {
  switch (waveform) {
    case WAVE_SINE:       return "SINE";
    case WAVE_SQUARE:     return "SQUARE";
    case WAVE_SAW:        return "SAW";
    case WAVE_TRIANGLE:   return "TRIANGLE";
    case WAVE_PULSE:      return "PULSE";
    case WAVE_NOISE:      return "NOISE";
    case WAVE_DOUBLE_SAW: return "DOUBLE_SAW";
    case WAVE_SUB_SQUARE: return "SUB_SQUARE";
    case WAVE_SINE_SUB:   return "SINE_SUB";
    default:              return "UNKNOWN";
  }
}

void sendSerialState() {
  Serial.print("{\"wave\":\"");
  Serial.print(waveformName());
  Serial.print("\",\"freq\":");
  Serial.print(frequency, 2);
  Serial.print(",\"targetFreq\":");
  Serial.print(targetFrequency, 2);
  Serial.print(",\"vol\":");
  Serial.print(volume, 2);
  Serial.print(",\"targetVol\":");
  Serial.print(targetVolume, 2);
  Serial.print(",\"pulseWidth\":");
  Serial.print(pulseWidth, 2);
  Serial.print(",\"sampleRate\":");
  Serial.print(SAMPLE_RATE);
  Serial.println("}");
}

// ======================================================
// SETUP
// ======================================================

void buildSineTable() {
  for (int i = 0; i < SINE_TABLE_SIZE; i++) {
    float angle = (float)i / (float)SINE_TABLE_SIZE * TWO_PI;
    sineTable[i] = (int16_t)(sinf(angle) * 2047.0f);
  }
}

void setup() {
  Serial.begin(115200);
  delay(500);

  buildSineTable();

  pinMode(PIN_CS, OUTPUT);
  digitalWrite(PIN_CS, HIGH);

  pinMode(PIN_BUTTON, INPUT_PULLUP);

  analogReadResolution(12);

  // Prima lettura per inizializzare i filtri senza salto iniziale
  pitchFiltered = analogRead(PIN_PITCH);
  volumeFiltered = analogRead(PIN_VOLUME);

  SPI.begin(PIN_SCK, -1, PIN_MOSI, PIN_CS);
  SPI.beginTransaction(SPISettings(20000000, MSBFIRST, SPI_MODE0));

  writeMCP4922A(DAC_CENTER);

  Serial.println("ESP32-S3 MCP4922 Multi-Wave Synth started");
  Serial.println("Short press = change waveform");
  Serial.println("Long press = debug ON/OFF");
}

// ======================================================
// LOOP
// ======================================================

void loop() {
  uint32_t nowMicros = micros();

  // AUDIO
  if (nowMicros - lastSampleMicros >= SAMPLE_PERIOD_US) {
    lastSampleMicros = nowMicros;

    frequency += (targetFrequency - frequency) * 0.0008f;
    volume += (targetVolume - volume) * 0.0015f;

    float sample = oscillatorProcess();
    sample *= volume;

    int dacValue = DAC_CENTER + (int)(sample * DAC_AMP_MAX);

    if (dacValue < 0) dacValue = 0;
    if (dacValue > 4095) dacValue = 4095;

    writeMCP4922A((uint16_t)dacValue);
  }

  // CONTROLLI
  if (millis() - lastControlsMillis >= 25) {
    updateControls();
    lastControlsMillis = millis();
  }

  // DEBUG SERIALE SOLO SE ATTIVO
  if (debugSerialEnabled && millis() - lastSerialMillis >= 1000) {
    sendSerialState();
    lastSerialMillis = millis();
  }
}
